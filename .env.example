# Copy to .env and fill in. Never commit .env.

# Which LLM to use: hkgai (the course gateway, default) or deepseek
LLM_PROVIDER=hkgai

# HKGAI (course gateway)
HKGAI_API_KEY=
HKGAI_BASE_URL=https://api1.hkgai.net/v1
HKGAI_MODEL=t2_hkgai-v3_fp8_1m_e7

# DeepSeek (used when LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Tools
# Set to 1 if fetch_url fails with "requires a publicly routable address" because your proxy answers DNS
# itself ("fake-IP" mode, every site resolves to 198.18.x.x). Leave it off otherwise.
FETCH_ALLOW_FAKE_IP=
GITHUB_TOKEN=
# Optional. Without it web_search uses a keyless DuckDuckGo/Bing search.
SEARCH_API_KEY=
