# Copy to .env and fill in. Never commit .env.

# Which LLM to use: hkgai (the course gateway, default) or deepseek
LLM_PROVIDER=hkgai

# HKGAI (course gateway)
HKGAI_API_KEY=
# Optional SerpApi key from serpapi.com for web_search with the HKGAI model in auto mode.
HKGAI_SEARCH_API_KEY=
HKGAI_BASE_URL=https://api1.hkgai.net/v1
HKGAI_MODEL=t2_hkgai-v3_fp8_1m_e7

# DeepSeek (used when LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# off (default): ask DeepSeek not to think, which is faster and what the agent loop needs; default: leave it to the service
DEEPSEEK_THINKING=off

# Tools
GITHUB_TOKEN=
# auto selects SerpApi for HKGAI (HKGAI_SEARCH_API_KEY) or DeepSeek search for DeepSeek (DEEPSEEK_API_KEY).
# If the selected key is missing or the service is unavailable, web_search falls back to keyless search through ddgs.
# fetch_url reads pages locally. With DeepSeek selected it can also ask DeepSeek to fetch a page when a site refuses access.
# deepseek selects DeepSeek search and fetch with either model. keyless selects ddgs and local page fetching.
SEARCH_PROVIDER=auto
