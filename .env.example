# Copy to .env and fill in. Never commit .env.

# Which LLM to use: hkgai (the course gateway, default) or deepseek
LLM_PROVIDER=hkgai

# HKGAI (course gateway)
HKGAI_API_KEY=
HKGAI_BASE_URL=https://api1.hkgai.net/v1
HKGAI_MODEL=t2_hkgai-v3_fp8_1m_e7

# DeepSeek (used when LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# off (default): ask DeepSeek not to think, which is faster and what the agent loop needs; default: leave it to the service
DEEPSEEK_THINKING=off

# Tools
GITHUB_TOKEN=
# Search for web_search. With LLM_PROVIDER=deepseek it uses DeepSeek's own search API with the same DEEPSEEK_API_KEY
# (about 5 yuan per 1000 searches). With LLM_PROVIDER=hkgai it uses SEARCH_API_KEY (the course's search key). Without
# either, or when one fails, it falls back to a slower, less reliable keyless search (DuckDuckGo and others).
SEARCH_API_KEY=
# auto (default) | deepseek | key (SEARCH_API_KEY only) | keyless
SEARCH_PROVIDER=auto
